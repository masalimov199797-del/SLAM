rules_version = '2';
// Правила для демонстрационного прототипа SLAM.
// Писать и читать может любой, кто открыл приложение (анонимный вход Firebase).
// Для рабочей версии нужны настоящие учётные записи и роли.
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.id == id;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review', 'syncedAt']);
    }
    match /photos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.reportId is string;
    }
    match /config/{doc} {
      allow read, write: if request.auth != null;
    }
    match /leads/{key} {
      allow read: if false;
      allow create, update, delete: if request.auth != null;
    }
  }
}
